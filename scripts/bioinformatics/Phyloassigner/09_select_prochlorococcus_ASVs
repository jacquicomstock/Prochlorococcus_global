grep "^>" $OLD/03_cyanobacteria/pro_ASVs.fasta \
    | sed 's/^>//' \
    | sort -u \
    > /tmp/old_pro_ids.txt

awk -F'\t' '
NR==FNR {x[$1]=1; next}
NR>1 && ($3 in x) {print $1}
' \
/tmp/old_pro_ids.txt \
$OLD/03_cyanobacteria/best_placements.tsv \
| sort -u \
> /tmp/pro_edges.txt

awk -F'\t' '
NR==FNR {edges[$1]=1; next}
NR>1 && ($1 in edges) {print $3}
' \
/tmp/pro_edges.txt \
07_PhyloAssigner/03_cyanobacteria/best_placements.tsv \
| sort -u \
> /tmp/new_pro_ids.txt

python - <<'PY'
from Bio import SeqIO

ids = set(
    line.strip()
    for line in open("/tmp/new_pro_ids.txt")
)

input_fasta = (
    "/project/azworden/users/jcomstock/M197_V1V2/"
    "07_PhyloAssigner/02_cyanoplastid/cyano_ASVs.fasta"
)

output_fasta = (
    "/project/azworden/users/jcomstock/M197_V1V2/"
    "07_PhyloAssigner/03_cyanobacteria/pro_ASVs.fasta"
)

records = [
    r for r in SeqIO.parse(input_fasta, "fasta")
    if r.id in ids
]

SeqIO.write(
    records,
    output_fasta,
    "fasta"
)

print(f"Wrote {len(records)} sequences")
print(f"Expected {len(ids)} sequences")
PY
